{
  "name": "khaborghor-newspaper",
  "version": "1.0.0",
  "description": "Bangla Online Newspaper matching editorial reference",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "seed": "npm run seed -w server",
    "build": "npm run build -w client",
    "lint": "eslint .",
    "test": "npm run test -w server",
    "qa:shot": "node scripts/shot.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.14.0",
    "gh-pages": "^6.3.0",
    "playwright": "^1.64.1",
    "prettier": "^3.3.3"
  }
}